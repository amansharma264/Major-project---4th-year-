# ==============================================================================
# TRIPLE-SHIELD VAULT - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to '.env.local' or '.env' and fill in your actual private values.
# NEVER commit your real '.env' file or Wi-Fi credentials to public version control.

# ------------------------------------------------------------------------------
# 1. HARDWARE KEYPAD AUTHENTICATION (ESP32 Integration)
# ------------------------------------------------------------------------------
# The 4-digit hardware PIN required to unlock the Triple-Shield Vault dashboard.
# Must match the PIN entered by the user on the physical 4x4 matrix keypad.
VAULT_PIN=2278

# Pre-shared cryptographic secret token used by the ESP32 to authenticate HTTP requests.
# The ESP32 firmware includes this in the 'X-ESP32-Token' HTTP request header.
# Generate a high-entropy secret string for production deployment.
ESP32_DEVICE_TOKEN=vault_esp32_secret_token_2026

# Cryptographic salt / secret used to sign and verify HttpOnly session cookies (HMAC-SHA256).
# Replace with a strong random 32+ character string in production.
SESSION_SECRET=vault_cryptographic_session_hmac_secret_2026_salt_replace_in_prod

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (Optional - for audit history persistence)
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/vault

# ------------------------------------------------------------------------------
# 3. WEB3 & ETHEREUM SMART CONTRACT (Layer 3 Ledger)
# ------------------------------------------------------------------------------
# Deployed contract address of PasswordLedger.sol on Sepolia / Ganache / Local EVM testnet
NEXT_PUBLIC_CONTRACT_ADDRESS=
